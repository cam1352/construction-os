// =============================================================================
// Prisma Schema: Construction Business OS & ERP Platform
// Engine: SQLite (Local/CI) & PostgreSQL (Production Compatible)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. CRM DOMAIN: Customers, Leads, and Communications
// -----------------------------------------------------------------------------

model Customer {
  id              String    @id @default(cuid())
  accountType     String    @default("INDIVIDUAL") // INDIVIDUAL | COMMERCIAL | GOVERNMENT
  firstName       String
  lastName        String
  companyName     String?
  email           String    @unique
  phone           String
  billingAddress  String
  billingCity     String
  billingState    String
  billingZip      String
  shippingAddress String?
  status          String    @default("ACTIVE") // ACTIVE | INACTIVE | DELINQUENT | ARCHIVED
  leadSource      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  leads          Lead[]             @relation("LeadConvertedCustomer")
  projects       Project[]
  invoices       Invoice[]
  payments       Payment[]
  estimates      Estimate[]
  communications CommunicationLog[]

  @@index([email])
  @@index([status])
  @@index([companyName])
}

model Lead {
  id                  String    @id @default(cuid())
  name                String
  companyName         String?
  email               String
  phone               String?
  source              String    @default("WEBSITE") // WEBSITE | REFERRAL | PHONE | AI_AGENT | THUMBTACK
  status              String    @default("NEW")     // NEW | CONTACTED | QUALIFIED | PROPOSAL_SENT | CONVERTED | LOST
  score               Int       @default(50)        // AI Qualification Score (0 - 100)
  estimatedBudget     Decimal?
  projectType         String?                       // RESIDENTIAL_REMODEL | COMMERCIAL_FITOUT | CLEANING | DRYWALL
  address             String?
  city                String?
  state               String?
  postalCode          String?
  notes               String?
  convertedCustomerId String?
  convertedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  convertedCustomer Customer?          @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  estimates         Estimate[]
  communications    CommunicationLog[]
  agentRuns         AgentRun[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model CommunicationLog {
  id          String   @id @default(cuid())
  channel     String   // EMAIL | SMS | CALL | INTERNAL_NOTE
  direction   String   // INBOUND | OUTBOUND
  customerId  String?
  leadId      String?
  projectId   String?
  sender      String
  recipient   String
  subject     String?
  body        String
  sentiment   String?  // POSITIVE | NEUTRAL | URGENT | FRUSTRATED
  aiGenerated Boolean  @default(false)
  agentId     String?  // e.g. "sales-agent-01"
  status      String   @default("SENT") // DRAFT | PENDING_APPROVAL | SENT | DELIVERED | FAILED
  createdAt   DateTime @default(now())

  // Relations
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([leadId])
  @@index([createdAt])
  @@index([aiGenerated])
}

// -----------------------------------------------------------------------------
// 2. CONSTRUCTION OPERATIONS: Projects, Estimates, WorkOrders
// -----------------------------------------------------------------------------

model Project {
  id            String    @id @default(cuid())
  projectNumber String    @unique // e.g. "PRJ-2026-001"
  title         String
  description   String?
  status        String    @default("PLANNING") // PLANNING | ESTIMATING | BID_APPROVED | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  priority      String    @default("MEDIUM")   // LOW | MEDIUM | HIGH | URGENT
  jobType       String    @default("RESIDENTIAL") // RESIDENTIAL | COMMERCIAL | INDUSTRIAL | SPECIALTY
  customerId    String
  estimateId    String?   @unique
  siteAddress   String
  siteCity      String
  siteState     String
  siteZip       String
  squareFootage Float?
  budgetAmount  Decimal   @default(0.0)
  contractValue Decimal   @default(0.0)
  actualCost    Decimal   @default(0.0)
  startDate     DateTime?
  targetEndDate DateTime?
  actualEndDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  customer                 Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  estimate                 Estimate?              @relation("ProjectEstimate", fields: [estimateId], references: [id], onDelete: SetNull)
  workOrders               WorkOrder[]
  invoices                 Invoice[]
  materialAssignments      ProjectMaterial[]
  subcontractorAssignments ProjectSubcontractor[]
  communications           CommunicationLog[]
  agentRuns                AgentRun[]

  @@index([customerId])
  @@index([status])
  @@index([startDate])
  @@index([projectNumber])
}

model Estimate {
  id                     String    @id @default(cuid())
  estimateNumber         String    @unique // e.g. "EST-2026-001"
  title                  String
  customerId             String?
  leadId                 String?
  status                 String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | SENT | APPROVED | REJECTED | EXPIRED
  totalLaborCost         Decimal   @default(0.0)
  totalMaterialCost      Decimal   @default(0.0)
  totalEquipmentCost     Decimal   @default(0.0)
  totalSubcontractorCost Decimal   @default(0.0)
  overheadMarkup         Decimal   @default(0.0)
  subtotal               Decimal   @default(0.0)
  taxRate                Decimal   @default(0.0)
  taxAmount              Decimal   @default(0.0)
  grandTotal             Decimal   @default(0.0)
  sqft                   Float?
  scopeOfWork            String?
  validUntil             DateTime?
  aiGenerated            Boolean   @default(false)
  aiConfidence           Float?
  metadata               String?   // Extended JSON parameters
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  customer  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead      Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  lineItems EstimateLineItem[]
  project   Project?           @relation("ProjectEstimate")

  @@index([customerId])
  @@index([leadId])
  @@index([status])
}

model EstimateLineItem {
  id              String         @id @default(cuid())
  estimateId      String
  category        String         // LABOR | MATERIAL | EQUIPMENT | SUBCONTRACTOR | PERMIT | OTHER
  description     String
  quantity        Float
  unit            String         // HOURS | SQFT | LINEAR_FT | UNIT | BAG | SHEET | LUMP_SUM
  unitPrice       Decimal
  totalPrice      Decimal
  materialId      String?
  subcontractorId String?
  orderIndex      Int            @default(0)

  // Relations
  estimate      Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  material      Material?      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)

  @@index([estimateId])
  @@index([category])
}

model WorkOrder {
  id              String    @id @default(cuid())
  workOrderNumber String    @unique // e.g. "WO-2026-001"
  projectId       String
  title           String
  description     String?
  status          String    @default("SCHEDULED") // PENDING | SCHEDULED | IN_PROGRESS | UNDER_INSPECTION | COMPLETED | CANCELLED
  priority        String    @default("MEDIUM")    // LOW | MEDIUM | HIGH | URGENT
  assignedTo      String?
  subcontractorId String?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor  Subcontractor?      @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  checklistItems WorkOrderLineItem[]

  @@index([projectId])
  @@index([subcontractorId])
  @@index([status])
}

model WorkOrderLineItem {
  id              String    @id @default(cuid())
  workOrderId     String
  taskDescription String
  completed       Boolean   @default(false)
  hoursSpent      Float     @default(0.0)
  orderIndex      Int       @default(0)

  // Relations
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// -----------------------------------------------------------------------------
// 3. PROCUREMENT & TRADE PARTNERS: Materials and Subcontractors
// -----------------------------------------------------------------------------

model Material {
  id               String   @id @default(cuid())
  sku              String   @unique // e.g. "MAT-DRY-001"
  name             String
  description      String?
  category         String   // DRYWALL | LUMBER | ELECTRICAL | PLUMBING | CLEANING | PAINT | HARDWARE
  unit             String   // SHEET | PIECE | GALLON | BOX | BAG | SQFT | LINEAR_FT
  unitCost         Decimal  @default(0.0)
  markupPercent    Decimal  @default(20.0)
  unitPrice        Decimal  @default(0.0)
  stockQuantity    Float    @default(0.0)
  reorderThreshold Float    @default(10.0)
  supplierName     String?
  supplierSku      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  projectMaterials  ProjectMaterial[]
  estimateLineItems EstimateLineItem[]
  invoiceLineItems  InvoiceLineItem[]

  @@index([category])
  @@index([sku])
  @@index([name])
}

model ProjectMaterial {
  id                String   @id @default(cuid())
  projectId         String
  materialId        String
  quantityEstimated Float    @default(0.0)
  quantityUsed      Float    @default(0.0)
  unitCostAtBooking Decimal  @default(0.0)
  totalCost         Decimal  @default(0.0)
  allocatedAt       DateTime @default(now())

  // Relations
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([projectId, materialId])
  @@index([projectId])
  @@index([materialId])
}

model Subcontractor {
  id              String    @id @default(cuid())
  companyName     String
  contactName     String
  trade           String    // ELECTRICAL | PLUMBING | HVAC | DRYWALL | CLEANING | ROOFING | PAINTING
  licenseNumber   String?
  insurancePolicy String?
  insuranceExpiry DateTime?
  email           String    @unique
  phone           String
  address         String?
  hourlyRate      Decimal?
  status          String    @default("ACTIVE") // ACTIVE | PENDING_VERIFICATION | SUSPENDED | INACTIVE
  rating          Float     @default(5.0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  projectAssignments ProjectSubcontractor[]
  workOrders         WorkOrder[]
  estimateLineItems  EstimateLineItem[]

  @@index([trade])
  @@index([status])
  @@index([email])
}

model ProjectSubcontractor {
  id              String    @id @default(cuid())
  projectId       String
  subcontractorId String
  agreedAmount    Decimal   @default(0.0)
  paidAmount      Decimal   @default(0.0)
  startDate       DateTime?
  completionDate  DateTime?
  status          String    @default("CONTRACTED") // CONTRACTED | WORKING | COMPLETED | DISPUTED

  // Relations
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)

  @@unique([projectId, subcontractorId])
  @@index([projectId])
  @@index([subcontractorId])
}

// -----------------------------------------------------------------------------
// 4. FINANCIAL & BILLING: Invoices, Line Items, and Payments
// -----------------------------------------------------------------------------

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique // e.g. "INV-2026-001"
  customerId    String
  projectId     String?
  status        String   @default("DRAFT") // DRAFT | ISSUED | PARTIALLY_PAID | PAID | OVERDUE | VOID | CANCELLED
  issueDate     DateTime @default(now())
  dueDate       DateTime
  subtotal      Decimal  @default(0.0)
  taxRate       Decimal  @default(0.0)
  taxAmount     Decimal  @default(0.0)
  totalAmount   Decimal  @default(0.0)
  amountPaid    Decimal  @default(0.0)
  balanceDue    Decimal  @default(0.0)
  paymentTerms  String   @default("NET_30") // DUE_ON_RECEIPT | NET_15 | NET_30 | NET_60
  notes         String?
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  customer  Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceNumber])
}

model InvoiceLineItem {
  id          String    @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Decimal
  amount      Decimal
  materialId  String?
  orderIndex  Int       @default(0)

  // Relations
  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id              String   @id @default(cuid())
  paymentNumber   String   @unique // e.g. "PMT-2026-001"
  invoiceId       String
  customerId      String
  amount          Decimal
  paymentDate     DateTime @default(now())
  paymentMethod   String   // CREDIT_CARD | ACH | CHECK | WIRE | CASH
  referenceNumber String?  // Check # or processor authorization
  status          String   @default("COMPLETED") // PENDING | COMPLETED | FAILED | REFUNDED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentDate])
}

// -----------------------------------------------------------------------------
// 5. AI AGENT FRAMEWORK AUDIT & EXECUTION LOGGING
// -----------------------------------------------------------------------------

model AgentRun {
  id                  String    @id @default(cuid())
  agentType           String    // SALES | ESTIMATING | PROJECT_MANAGEMENT | CUSTOMER_SERVICE | ADMIN | MARKETING
  agentInstanceId     String    // Pool worker identity
  status              String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  leadId              String?
  projectId           String?
  inputPayload        String    // JSON stringified input request
  outputPayload       String?   // JSON stringified agent output
  executionDurationMs Int?
  tokensUsed          Int       @default(0)
  errorMessage        String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  // Relations
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([agentType])
  @@index([status])
  @@index([createdAt])
}
